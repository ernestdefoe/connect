# Keep the Composer/Packagist archive lean — ship only what a running forum
# needs. GitHub still shows everything; export-ignore only affects `composer
# require` archives.
/.github        export-ignore
/js/src         export-ignore
/js/node_modules export-ignore
/js/package.json export-ignore
/js/package-lock.json export-ignore
/js/tsconfig.json export-ignore
/js/webpack.config.js export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
*.map           export-ignore
